# --- API ---
ENVIRONMENT=development
DEBUG=false
# Comma-separated allowed origins, or * for development.
CORS_ORIGINS=*
# Set by Railway's Postgres plugin.
DATABASE_URL=
# Scenario guardrails.
MAX_SIMULATION_SECONDS=300
MAX_VEHICLES=500

# --- Web ---
# Server-side API base (Railway private networking in production).
API_URL=http://localhost:8000
# Browser-accessible API base (optional).
NEXT_PUBLIC_API_URL=http://localhost:8000
